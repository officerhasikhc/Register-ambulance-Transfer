            "mimeType": "application/json",
            "text": "{\n  \"id\": \"/login.html\",\n  \"name\": \"نظام سجل نشاط الإسعاف - مركز حاسك الصحي\",\n  \"short_name\": \"إدارة الإسعاف\",\n  \"description\": \"نظام تسجيل رحلات الإسعاف - المديرية العامة للخدمات الصحية بمحافظة ظفار - مركز حاسك الصحي\",\n  \"start_url\": \"./login.html?lang=ar\",\n  \"scope\": \"./\",\n  \"display\": \"standalone\",\n  \"background_color\": \"#1e40af\",\n  \"theme_color\": \"#1e40af\",\n  \"orientation\": \"portrait\",\n  \"prefer_related_applications\": false,\n  \"categories\": [\"medical\", \"productivity\"],\n  \"icons\": [\n    {\n      \"src\": \"./icon-512x512.png\",\n      \"sizes\": \"512x512\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"./icon-512x512-maskable.png\",\n      \"sizes\": \"512x512\",\n      \"type\": \"image/png\",\n      \"purpose\": \"maskable\"\n    },\n    {\n      \"src\": \"./icon-192x192.png\",\n      \"sizes\": \"192x192\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"./icon-192x192-maskable.png\",\n      \"sizes\": \"192x192\",\n      \"type\": \"image/png\",\n      \"purpose\": \"maskable\"\n    },\n    {\n      \"src\": \"./icon-180x180-apple.png\",\n      \"sizes\": \"180x180\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"./icon-144x144.png\",\n      \"sizes\": \"144x144\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"./icon-96x96.png\",\n      \"sizes\": \"96x96\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"./icon-72x72.png\",\n      \"sizes\": \"72x72\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    },\n    {\n      \"src\": \"./icon-48x48.png\",\n      \"sizes\": \"48x48\",\n      \"type\": \"image/png\",\n      \"purpose\": \"any\"\n    }\n  ],\n  \"screenshots\": [\n    {\n      \"src\": \"./og-image.png\",\n      \"sizes\": \